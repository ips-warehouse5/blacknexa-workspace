{
  "name": "blacknexa-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BlackNexa News, Geo-Legal, Platform & Enterprise API — Node.js / Express / TypeScript / PostgreSQL",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "overridesNote": "Sequelize pins uuid@8, which carries GHSA-w5hq-g745-h8pq (a bounds check in the v3/v5/v6 buffer path). Sequelize only uses v4 without a buffer, so the advisory is not reachable here, but forcing v11 clears it without downgrading Sequelize — which is what `npm audit fix --force` would otherwise do.",
  "overrides": {
    "uuid": "^11.0.5"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node -r tsconfig-paths/register src/server.ts\"",
    "build": "rimraf dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:sync": "ts-node -r tsconfig-paths/register src/scripts/sync_db.ts",
    "db:seed": "ts-node -r tsconfig-paths/register src/scripts/seed_db.ts",
    "db:snapshot": "ts-node -r tsconfig-paths/register src/scripts/snapshot.ts",
    "smoke:auth": "bash scripts/smoke_auth.sh",
    "smoke:reports": "bash scripts/smoke_reports.sh",
    "job:reports": "ts-node -r tsconfig-paths/register src/scripts/run_report_maintenance.ts",
    "smoke:moderation": "bash scripts/smoke_moderation.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.5.13",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
