# ─────────────────────────────────────────────────────────────────────────────
# BlackNexa Backend — environment
#
# Every variable marked REQUIRED is validated on boot by src/config/env.config.ts.
# The process exits with a non-zero code and a list of the offending keys if any
# required variable is missing or malformed. Never commit a real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
PORT=4000
# Origin this API is publicly reachable at. Used to build self-served image and
# audio URLs (/api/v1/news/image/:id). Falls back to the request origin when unset,
# but MUST be set in production so background jobs emit correct absolute URLs.
PUBLIC_API_ORIGIN=http://localhost:4000
# Public website origin used in RSS / sitemaps / JSON-LD / server-rendered HTML.
PUBLIC_SITE_ORIGIN=https://blacknexa.com
# Set to true (or a hop count) when running behind a proxy / load balancer so
# req.ip is the real client IP for rate limiting and ToS agreement records.
TRUST_PROXY=false

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Either supply DATABASE_URL, or all of DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blacknexa
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=blacknexa
# DB_USER=postgres
# DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_LOGGING=false
# Auto-run sequelize.sync() on boot. Convenient in development; env validation
# refuses to start production with DB_SYNC=true — use a migration there.
DB_SYNC=true
# `alter: true` is only safe on a first run. Sequelize re-emits foreign-key DDL on
# every pass and generates invalid SQL for tables that already have constraints, so
# leave this false for repeat boots and run `npm run db:sync` when the schema changes.
DB_SYNC_ALTER=false

# ── CORS (REQUIRED in production) ────────────────────────────────────────────
# Comma-separated exact origins. Wildcards are rejected in production.
# Mobile apps send no Origin header, so they are always allowed.
# Where the admin console is served. Used only to build the sign-in link in
# operator emails — it is a display value, never a redirect target, so it cannot
# become an open redirect.
ADMIN_CONSOLE_URL=http://localhost:5174

CORS_ORIGINS=http://localhost:8081,http://localhost:19006,https://blacknexa.com

# ── JWT (REQUIRED) ───────────────────────────────────────────────────────────
# Minimum 32 characters each, and the two secrets must differ.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
BCRYPT_DUMMY_HASH=$2a$12$invalidinvalidinvalidinvalidinvalidinvalidinvalidinva

# ── Encryption at rest ───────────────────────────────────────────────────────
# Seals report bodies and exact locations. At least 32 characters when set.
# When set, new rows are sealed with it; existing rows still open, because the
# reader tries this secret first and then the legacy chain (AI_TOOLKIT_SECRET_KEY,
# JWT_ACCESS_SECRET) that sealed them. When blank, the legacy chain seals, as
# before. Set it before removing AI_TOOLKIT_SECRET_KEY from this service, and
# never rotate it without keeping the old value available.
SERVER_ENCRYPTION_SECRET=
# ── AI Gateway (Rork Toolkit) ────────────────────────────────────────────────
# Without the secret key, all AI paths degrade gracefully: the feed still serves
# stored/seed articles, generation returns a 500 "AI gateway not configured",
# translations fall back to English, and the geo-legal resolver falls back to the
# curated jurisdiction database.
AI_TOOLKIT_URL=https://toolkit.rork.com
AI_TOOLKIT_SECRET_KEY=
# Legacy aliases accepted for drop-in parity with the Worker env:
# EXPO_PUBLIC_TOOLKIT_URL=
# EXPO_PUBLIC_RORK_TOOLKIT_SECRET_KEY=

# ── Python AI news engine (optional) ─────────────────────────────────────────
# When both URL and TOKEN are set, the news AI paths — grounded search, briefing
# synthesis, imagery, TTS and article translation — are delegated to the
# `blacknexa-ai-engine` service. Leave them empty to keep using the in-process
# implementation, which also remains the automatic fallback if a configured
# engine is unreachable. Adopting or rolling back is a config change, not a deploy.
#
# In that deployment the AI_TOOLKIT_SECRET_KEY above is not needed here at all —
# it lives in the engine instead, which is one fewer place holding it.
AI_ENGINE_URL=
# Preferably the shared SERVICE_JWT_SECRET from the engine, in which case Node
# mints short-lived tokens itself. A pre-minted JWT is also accepted.
AI_ENGINE_TOKEN=
# Generous: a deep synthesis runs a web search, a 7200-token completion and an
# image generation within one call.
AI_ENGINE_TIMEOUT_MS=90000
AI_ENGINE_TOKEN_TTL_SECONDS=900
AI_ENGINE_ISSUER=blacknexa-backend
AI_ENGINE_AUDIENCE=blacknexa-ai-engine

# ── Background jobs ──────────────────────────────────────────────────────────
# Enable on exactly ONE replica. Replaces the Durable Object alarms.
ENABLE_CRON=true
# Daily grounded-article batch. Worker fired at 06:00 UTC.
CRON_DAILY_NEWS=0 6 * * *
# Platform maintenance: drain queue, prune cache, prune jobs, auto-snapshot.
CRON_PLATFORM_MAINTENANCE=* * * * *
# Evidence purge, counter reconciliation, expired-code pruning.
# 03:20 UTC: off the hour so it does not collide with everything else,
# and late enough that a retention boundary has passed everywhere.
CRON_REPORT_MAINTENANCE=20 3 * * *
# Fire IndexNow / sitemap pings after a publish.
ENABLE_SEARCH_ENGINE_PING=true

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000          # 15 minutes
RATE_LIMIT_MAX=300                   # general /api/v1 budget per window per IP
RATE_LIMIT_AUTH_MAX=8                # login / refresh — brute-force guard
RATE_LIMIT_WRITE_MAX=30              # generate, tip, incident create, beacon
RATE_LIMIT_READ_MAX=600              # public feed reads
# Per member (keyed by account, not IP), same window as above.
RATE_LIMIT_USER_WRITE_MAX=120        # report wizard: drafts, evidence presign/commit, filing
RATE_LIMIT_FLAG_MAX=20               # flags per window
RATE_LIMIT_FLAG_DAILY_MAX=50         # flags per 24 hours

# ── Upload / S3 (optional) ───────────────────────────────────────────────────
# Only required if STORAGE_DRIVER=s3. Private objects are served via presigned
# URLs; nothing is ever exposed through a public static directory.
STORAGE_DRIVER=db                    # db | s3
MAX_UPLOAD_BYTES=10485760            # 10 MB
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PRESIGN_EXPIRES_SECONDS=900

# ── Admin bootstrap (optional) ───────────────────────────────────────────────
# When both are set, a super-admin is created on first boot if none exists.
# Remove them once the account exists.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info                       # error | warn | info | http | debug

# ─────────────────────────────────────────────────────────────────────────────
# End-user accounts and the report module (design sections A–D)
# ─────────────────────────────────────────────────────────────────────────────

# ── Outbound email ───────────────────────────────────────────────────────────
# Screens A8, A13 and A14 all wait on a code that arrives by email, so this is a
# hard dependency for sign-up. Leave SMTP_HOST blank in development and the
# mailer logs the message instead of sending it — the whole flow stays walkable
# without a provider. Env validation refuses that in production when
# REPORTS_ENABLED=true.
# With docker-compose up, Mailpit catches everything: SMTP_HOST=localhost,
# SMTP_PORT=1025, inbox at http://localhost:8025
# Gmail: use an App Password, not the account password — Google rejects plain
# passwords on SMTP. Generate one at myaccount.google.com/apppasswords (needs
# 2-Step Verification on). Paste it with or without spaces; both work.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587          # STARTTLS. Use 465 only with SMTP_SECURE=true.
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=xxxx xxxx xxxx xxxx
#
# MAIL_FROM must be the authenticated account or one of its verified
# "Send mail as" aliases — Gmail silently rewrites anything else, so a From of
# another domain will not appear as you expect.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BlackNexa <no-reply@blacknexa.com>
MAIL_REPLY_TO=

# ── One-time codes (A8, A14) ─────────────────────────────────────────────────
# A13's copy promises the code is "good for fifteen minutes" — keep 900 unless
# that copy changes too.
OTP_TTL_SECONDS=900
OTP_MAX_ATTEMPTS=5
# Backs the A8 / A14 resend countdown. Lower it locally if the smoke test's wait
# is tedious; do not lower it in a shared environment.
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_LENGTH=6

# ── Push (A11's four notification types) ─────────────────────────────────────
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# ── Native social sign-in (A5) ───────────────────────────────────────────────
# Identity tokens are verified against each provider's JWKS server-side. Leaving
# these blank disables that provider with a clear 503 rather than a vague failure.
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=
# Comma-separated: the iOS, Android and web client ids are all valid audiences.
GOOGLE_CLIENT_IDS=

# ── Apple token revocation (App Store requirement) ───────────────────────────
# Apple requires any app offering Sign in with Apple to revoke the user's token
# when they delete their account. These sign the client secret that call needs.
# Leave blank and revocation is disabled — the rest of Apple sign-in still works.
#
# Where each value comes from, at https://developer.apple.com/account :
#   APPLE_TEAM_ID  — Membership details → Team ID (10 chars).
#   APPLE_KEY_ID   — Certificates, Identifiers & Profiles → Keys → your "Sign in
#                    with Apple" key. It is also in the filename Apple gave you:
#                    AuthKey_<APPLE_KEY_ID>.p8
#   the .p8 itself — downloadable exactly once when the key is created. Apple
#                    will not let you re-download it; a lost key must be revoked
#                    and replaced.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Supply the key ONE of two ways. Inline takes precedence if both are set.
#
#   1. Path to the file — easiest locally. Relative paths resolve from the
#      backend directory. Keep it OUT of the repo, or at least somewhere
#      .gitignore covers (*.p8 is ignored).
APPLE_PRIVATE_KEY_PATH=
#   2. Inline PEM — best for containers and hosts with no filesystem to mount.
#      Real newlines cannot live in a .env value, so escape them as \n:
#      APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----\n"
APPLE_PRIVATE_KEY=

# ── Report module ────────────────────────────────────────────────────────────
REPORTS_ENABLED=true
# Screen C5 attaches a 24.8 MB video, so the per-file cap is 64 MB.
MAX_UPLOAD_BYTES=67108864
MAX_EVIDENCE_PER_REPORT=10
MAX_EVIDENCE_BYTES_PER_REPORT=268435456
# D2: "Sealed files are destroyed after 30 days."
REPORT_EVIDENCE_RETENTION_DAYS=30
# C6: an urgent report is seen "within the hour".
MODERATION_URGENT_SLA_MINUTES=60

# ── Automated moderation (docs/INCIDENT_MODULE_PLAN.md §5.5) ─────────────────
# Public and trusted reports, their evidence and comments are checked before
# anyone else sees them: a keyword stage in Node, then the Python engine's
# /api/v1/internal/moderation/assess (AI_ENGINE_URL / AI_ENGINE_TOKEN above).
# Private reports are never sent. Apply the schema first:
#   npm run db:migrate:moderation     (safe to re-run; always after db:sync)
#
# false skips the AI stage only (ai_status=skipped). The fallbacks below still
# apply, so this is NOT a publish-everything switch: reports hold for a human.
MODERATION_ENABLED=true
# Run the moderation worker in this process. Safe on every replica (runs are
# claimed with FOR UPDATE SKIP LOCKED) and independent of ENABLE_CRON.
MODERATION_WORKER_ENABLED=true
# Runs processed in parallel per process, and the idle poll interval.
MODERATION_WORKER_CONCURRENCY=4
MODERATION_WORKER_POLL_MS=1500
# How long a claimed run is leased before another replica may re-claim it.
# Boot refuses unless LEASE_SECONDS × 1000 ≥ 2 × MODERATION_AI_TIMEOUT_MS + 30000.
MODERATION_LEASE_SECONDS=120
# Per-call timeout for the assess endpoint (engine model timeout 30 s + overhead).
MODERATION_AI_TIMEOUT_MS=40000
# Attempts before the terminal path (report held for a human; a keyword-clean
# comment approved). Backoff 15 s, 60 s, 4 min. Urgent reports use min(2, this).
MODERATION_MAX_ATTEMPTS=4
# Policy thresholds (0–1). Auto-approve needs the AI's "approve" at or above the
# first; a category at or above the second is a violation; a flag re-check may
# auto-hide only at or above the third, with a verbatim evidence quote.
MODERATION_AUTO_APPROVE_MIN_CONFIDENCE=0.8
MODERATION_VIOLATION_MIN_CONFIDENCE=0.5
MODERATION_FLAG_AUTOHIDE_MIN_CONFIDENCE=0.85
# When the AI cannot answer: reports hold (fail closed). `approve` exists for a
# laptop without an AI key and is REFUSED at boot in production.
MODERATION_REPORT_AI_FALLBACK=hold    # hold | approve
# Comments with no keyword hit approve when the AI cannot answer.
MODERATION_COMMENT_AI_FALLBACK=approve  # approve | hold
# Video, audio, documents and photos without a thumbnail: wait for a moderator
# (the text may still publish), or publish with the text.
MODERATION_UNASSESSED_MEDIA=review    # review | publish
# Only flaggers whose account is at least this old trigger an AI re-check.
MODERATION_FLAG_MIN_ACCOUNT_AGE_DAYS=7
# Photo thumbnails sent per assessment (0–10; needs STORAGE_DRIVER=s3).
MODERATION_MAX_IMAGES=10
# Extra comma-separated recipients for urgent / safety-risk alerts. Active
# moderators and superadmins are always emailed; the alert has no report content.
MODERATION_ALERT_EMAILS=
