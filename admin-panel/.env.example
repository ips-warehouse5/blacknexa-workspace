# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: these are read at BUILD time, not at run time.
#
# Vite inlines every VITE_* value into the bundle when you run `npm run build`.
# Editing this file on a server changes nothing until you rebuild. If a setting
# below does not seem to be taking effect, that is almost always why.
# ─────────────────────────────────────────────────────────────────────────────

# Where the browser sends API calls.
#
# A RELATIVE value ("/api/v1") resolves against whatever origin serves the page.
# That is correct in development, where the dev-server proxy below forwards it,
# and correct in production only if the same web server also serves the API at
# that path.
#
# If the API lives on a different host, this MUST be the absolute URL — the
# proxy setting below does not apply to a build. Example for a deployment where
# the console is on blacknexa.example.com and the API on api-blacknexa.example.com:
#
#   VITE_API_BASE_URL=https://api-blacknexa.example.com/api/v1
#
# Setting an absolute cross-origin URL makes these real cross-origin requests,
# so the API's CORS_ORIGINS must list the console's origin — see below.
VITE_API_BASE_URL=/api/v1

# Where `npm run dev` forwards /api to.
#
# DEVELOPMENT ONLY. Vite's dev server implements this; a production build has no
# dev server, so this value never reaches the browser and is absent from the
# bundle entirely. It does not configure a deployed console.
VITE_API_PROXY_TARGET=http://localhost:3010

# Shown in the sidebar and the browser title.
VITE_APP_NAME=BlackNexa

# Feature flag: when true, screens that are not yet wired to the API render
# their prototype fixtures instead of calling it. Authentication and the
# admin/roles module ignore this — they are always live.
VITE_USE_MOCK_DATA=true

# ─────────────────────────────────────────────────────────────────────────────
# Deploying to a different origin from the API
#
# Two workable arrangements. Pick one.
#
# A. Absolute URL + CORS
#    Here:            VITE_API_BASE_URL=https://api-blacknexa.example.com/api/v1
#    On the API:      CORS_ORIGINS=https://blacknexa.example.com
#    Then rebuild the console and restart the API.
#
#    A browser can only read a response header the server names in
#    `exposedHeaders`; the API already exposes Retry-After, which the sign-in
#    lockout countdown needs.
#
# B. Relative URL + a reverse proxy (no CORS at all)
#    Leave VITE_API_BASE_URL=/api/v1 and have the web server in front of the
#    console forward /api to the API host. nginx:
#
#      location /api/ {
#        proxy_pass         https://api-blacknexa.example.com;
#        proxy_set_header   Host              api-blacknexa.example.com;
#        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
#        proxy_set_header   X-Forwarded-Proto $scheme;
#      }
#
#    The requests stay same-origin, so no CORS configuration is needed. If you
#    do this, set TRUST_PROXY=true on the API so rate limiting sees the real
#    client address rather than the proxy's.
# ─────────────────────────────────────────────────────────────────────────────
