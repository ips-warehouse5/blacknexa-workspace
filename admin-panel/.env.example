# Base path of the BlackNexa API. Left relative so the dev proxy in
# vite.config.ts can serve it same-origin; set it to an absolute URL only when
# the console is deployed to a different origin from the API.
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api to. Development only — not read in a build.
VITE_API_PROXY_TARGET=http://localhost:4000

# Shown in the sidebar and the browser title.
VITE_APP_NAME=BlackNexa

# Feature flag: when true, screens that are not yet wired to the API render
# their prototype fixtures instead of calling it. Authentication and the
# admin/roles module ignore this — they are always live.
VITE_USE_MOCK_DATA=true
