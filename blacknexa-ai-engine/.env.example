# ─────────────────────────────────────────────────────────────────────────────
# BlackNexa AI News Engine — environment
#
# Validated on boot by app/core/config.py. The process exits with a list of the
# offending keys if anything required is missing or malformed.
# Never commit a real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | test | production
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                   # must be true in production

# ── Gemini (REQUIRED in production) ──────────────────────────────────────────
# Every model call goes straight to Google's Generative Language API — synthesis,
# imagery, speech and translation. Get a key at https://aistudio.google.com/apikey
# Without it the engine still boots, but /ready reports false and every AI path
# returns a null result.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── Exa web search (REQUIRED in production) ──────────────────────────────────
# The grounding stage. Gemini's built-in search grounding returns opaque redirect
# links with no excerpts, which the source cards and the citation-intersection
# check both need — so search is its own provider. Key from https://exa.ai
# Without it every synthesis fails with `no_source_material`.
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai

# Transport tuning — ported from the Node engine. Change only with a reason.
AI_TIMEOUT_SECONDS=20
AI_RETRY_DELAY_SECONDS=0.3
AI_MAX_ATTEMPTS=2

# Models. Bare Gemini ids — the old `google/` prefix was gateway routing syntax,
# not part of the name. Flash-lite is the lowest-latency text model, which is what
# lets a user-facing briefing return in about two seconds.
AI_SYNTHESIS_MODEL=gemini-2.5-flash-lite
AI_IMAGE_MODEL=gemini-2.5-flash-image
AI_TRANSLATION_MODEL=gemini-2.5-flash-lite
# Gemini TTS returns raw PCM, which the engine wraps as WAV — briefings are
# `audio/wav`, not `audio/mpeg`.
AI_TTS_MODEL=gemini-2.5-flash-preview-tts
# One of Gemini's prebuilt voice names (capitalised): Kore, Puck, Charon, Aoede…
AI_TTS_VOICE=Kore

# 0 disables model thinking. Thought tokens are billed against max_output_tokens
# and add seconds of latency; a thought-heavy answer can return no text at all.
# Raise only when debugging output quality.
GEMINI_THINKING_BUDGET=0

# Safety filtering for the four tunable harm categories. Reporting on police
# accountability, civil rights and geopolitics trips Gemini's stricter defaults
# often enough to break the feed. Editorial control comes from the synthesis
# prompt and the prompt-injection screen instead.
# BLOCK_NONE | BLOCK_ONLY_HIGH | BLOCK_MEDIUM_AND_ABOVE | BLOCK_LOW_AND_ABOVE | OFF
GEMINI_SAFETY_THRESHOLD=BLOCK_ONLY_HIGH

# ── Service auth (REQUIRED) ──────────────────────────────────────────────────
# Shared with the Node backend, which mints the tokens it calls with.
# Minimum 32 characters.
SERVICE_JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
SERVICE_JWT_ALGORITHM=HS256
SERVICE_JWT_ISSUER=blacknexa-backend
SERVICE_JWT_AUDIENCE=blacknexa-ai-engine
SERVICE_TOKEN_TTL_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Empty is correct: this service is called server-to-server and should be network
# isolated. Populate only for a trusted internal console. '*' is rejected in
# production.
CORS_ORIGINS=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Keyed by service-token subject, not IP. These bound gateway spend as much as
# they bound load.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=600/minute
RATE_LIMIT_GENERATION=60/minute

# ── Prompt-injection guardrails ──────────────────────────────────────────────
MAX_TOPIC_PROMPT_CHARS=1000
MAX_SOURCE_EXCERPT_CHARS=4000
MAX_TRANSLATE_CONTENT_CHARS=200000
# true  → a topic carrying instruction-override phrasing is refused (recommended)
# false → it is neutralised and passed through instead
REJECT_SUSPICIOUS_PROMPTS=true

# ── Run-log persistence (optional) ───────────────────────────────────────────
# Observability only — timings, outcomes, source counts. Never article content.
# Leave DATABASE_URL empty to run fully stateless.
# Use a SEPARATE database or schema from the Node backend: this service owns only
# its own table and must never be able to touch the article tables.
DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=5
RUN_LOG_RETENTION_DAYS=30
