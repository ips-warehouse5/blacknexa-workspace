# ─────────────────────────────────────────────────────────────────────────────
# BlackNexa AI News Engine — environment
#
# Validated on boot by app/core/config.py. The process exits with a list of the
# offending keys if anything required is missing or malformed.
# Never commit a real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | test | production
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                   # must be true in production

# ── AI gateway (REQUIRED in production) ──────────────────────────────────────
# The same Rork Toolkit gateway the Node backend uses, so this is a drop-in for
# its in-process AI layer. Without the secret the engine still boots, but /ready
# reports false and every AI path returns a null result.
AI_TOOLKIT_URL=https://toolkit.rork.com
AI_TOOLKIT_SECRET_KEY=

# Transport tuning — ported from the Node engine. Change only with a reason.
AI_TIMEOUT_SECONDS=20
AI_RETRY_DELAY_SECONDS=0.3
AI_MAX_ATTEMPTS=2

# Models. Flash-lite is the lowest-latency text model on the gateway, which is
# what lets a user-facing briefing return in about two seconds.
AI_SYNTHESIS_MODEL=google/gemini-2.5-flash-lite
AI_IMAGE_MODEL=google/gemini-2.5-flash-image
AI_TRANSLATION_MODEL=google/gemini-2.5-flash-lite
AI_TTS_MODEL=xai/grok-tts
AI_TTS_VOICE=eve

# ── Service auth (REQUIRED) ──────────────────────────────────────────────────
# Shared with the Node backend, which mints the tokens it calls with.
# Minimum 32 characters.
SERVICE_JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
SERVICE_JWT_ALGORITHM=HS256
SERVICE_JWT_ISSUER=blacknexa-backend
SERVICE_JWT_AUDIENCE=blacknexa-ai-engine
SERVICE_TOKEN_TTL_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Empty is correct: this service is called server-to-server and should be network
# isolated. Populate only for a trusted internal console. '*' is rejected in
# production.
CORS_ORIGINS=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Keyed by service-token subject, not IP. These bound gateway spend as much as
# they bound load.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=600/minute
RATE_LIMIT_GENERATION=60/minute

# ── Prompt-injection guardrails ──────────────────────────────────────────────
MAX_TOPIC_PROMPT_CHARS=1000
MAX_SOURCE_EXCERPT_CHARS=4000
MAX_TRANSLATE_CONTENT_CHARS=200000
# true  → a topic carrying instruction-override phrasing is refused (recommended)
# false → it is neutralised and passed through instead
REJECT_SUSPICIOUS_PROMPTS=true

# ── Run-log persistence (optional) ───────────────────────────────────────────
# Observability only — timings, outcomes, source counts. Never article content.
# Leave DATABASE_URL empty to run fully stateless.
# Use a SEPARATE database or schema from the Node backend: this service owns only
# its own table and must never be able to touch the article tables.
DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=5
RUN_LOG_RETENTION_DAYS=30
