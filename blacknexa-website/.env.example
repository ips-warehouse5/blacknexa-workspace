# BlackNexa website — environment template.
# Copy to .env.local and fill in. Nothing here is a secret; the values are
# server-side URLs used by the route handlers under src/app/api.

# Where the contact form's submissions are forwarded.
# Handled by the platform API: POST /api/v1/contact (public, rate-limited).
# Read by src/app/api/contact/route.ts — when it is unset that route answers
# 503 and the form tells the visitor the service is not configured.
CONTACT_API_URL=http://localhost:4000/api/v1/contact

# Where waitlist signups are forwarded. No backend endpoint exists for this
# yet, so leave it unset until one does — an unset value fails visibly, while
# a wrong one drops signups silently.
# WAITLIST_API_URL=
