# BlackNexa website — environment configuration
#
# Copy this file to `.env.local` and fill in real values for local
# development. Never commit `.env.local` or real secrets.

# Base URL of the platform API, including the version prefix.
# Every backend call is built from this by src/lib/api/client.ts; individual
# endpoint paths ("/contact", …) live in code beside the feature that uses
# them, not here.
#
# Server-side only — no NEXT_PUBLIC_ prefix, so it never reaches the browser
# bundle. The browser talks to this app's own /api/* routes, which proxy through.
#
# When unset, the routes that need it answer 503 and say so, rather than
# failing in a way that looks like a bug.
API_BASE_URL=http://localhost:3010/api/v1

# Public site URL used for metadata, canonical URLs, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://blacknexa.com
 
# Waitlist API — full endpoint URL the waitlist form's server route
# (src/app/api/waitlist/route.ts) forwards signups to. Until this is
# set, the waitlist form returns a 503 "not configured yet" error.
# WAITLIST_API_URL=
 
# Contact API — full endpoint URL the contact form's server route
# (src/app/api/contact/route.ts) forwards messages to. Until this is
# set, the contact form returns a 503 "not configured yet" error.
# CONTACT_API_URL=
 
# News API — base URL for the BlackNexa backend's news API, e.g.
# https://api.blacknexa.com/api/v1/news
# `/feed` and `/article/:slug` are appended per call (see src/data/news.ts),
# matching blacknexa-backend/src/routes/news.route.ts. Read directly
# server-side by the homepage News section, /news, and /news/[slug]. Until
# this is set, those pages render their documented empty/not-found states.
# NEWS_API_BASE_URL=
 
