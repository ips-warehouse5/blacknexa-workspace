{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev-client": "expo start --dev-client",
    "start:go": "expo start",
    "start:tunnel": "expo start --dev-client --tunnel",
    "start:clear": "expo start --dev-client -c",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:prod:android": "eas build --profile production --platform android",
    "watchman": "watchman watch-del-all && watchman shutdown-server",
    "clean": "watchman watch-del-all && expo start -c",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
