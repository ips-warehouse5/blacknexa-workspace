# Copy relevant values into `.env` for local overrides (gitignored), or into
# `.env.development` / `.env.production` for values shared by everyone on
# that environment. Never commit real secrets to `.env.development` or
# `.env.production` — those two files ARE committed to the repo.

# Which environment this build/config targets ("development" | "production").
# Normally set per-file (.env.development / .env.production), not here.
EXPO_PUBLIC_APP_ENV=

# BlackNexa API origin, no trailing slash required (normalized at runtime).
EXPO_PUBLIC_API_BASE_URL=

# BlackNexa News & Syndication Worker origin. Optional — falls back to
# EXPO_PUBLIC_API_BASE_URL when unset.
EXPO_PUBLIC_RORK_FUNCTIONS_URL=

# Rork Auth Service
EXPO_PUBLIC_RORK_AUTH_URL=
EXPO_PUBLIC_RORK_APP_KEY=
EXPO_PUBLIC_PROJECT_ID=

# Google Sign-In OAuth client IDs
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Maps API keys
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_WEB_API_KEY=

# Gemini / generative-language API (server-side only — DO NOT prefix with
# EXPO_PUBLIC_, or the key will be bundled into the client and publicly
# readable).
GEMINI_API_KEY=
GEMINI_BASE_URL=
